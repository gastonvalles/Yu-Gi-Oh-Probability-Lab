{
  "name": "ygo-probability-lab",
  "private": true,
  "version": "0.0.0",
  "author": "Gastón Valles",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/write-build-id.mjs && node scripts/build-auto-data.mjs && tsc -p src/tsconfig.json && vite build",
    "gate": "node scripts/ti/gate.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync:genesys": "node scripts/sync-genesys-card-data.mjs",
    "sync:banlists": "node scripts/sync-banlists.mjs",
    "sync:core": "node scripts/sync-core-data.mjs",
    "sync:effects": "node scripts/build-card-effects.mjs",
    "sync:meta": "node scripts/sync-meta-decks.mjs",
    "sync:prices": "node scripts/sync-card-prices.mjs",
    "sync:replays": "node scripts/sync-replays.mjs",
    "test": "vitest --run",
    "test:auto": "vitest --run --project slow",
    "test:e2e": "playwright test",
    "test:prod": "playwright test -c playwright.prod.config.ts",
    "test:prod:noche": "playwright test -c playwright.prod.config.ts --grep @noche",
    "typecheck": "tsc -p src/tsconfig.test.json"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-redux": "^9.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "ocgcore-wasm": "0.1.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "source-map-js": ">=1.2.2"
  }
}
